# --- Same-origin reverse proxy (recommended) -------------------------------
# Empty string = the browser calls /api/v1/... on this site and Next forwards
# it to BACKEND_ORIGIN. The empty value is deliberate; leaving the variable out
# entirely is an error.
NEXT_PUBLIC_API_BASE_URL=
# Server-only (never NEXT_PUBLIC_). Origin only: no path, no trailing slash.
# BUILD-TIME: baked into the build, so rebuild after changing it.
#   native dev:      http://localhost:8080
#   docker compose:  http://backend:8080   (set in infra/docker-compose.yml)
BACKEND_ORIGIN=http://localhost:8080

# --- Direct mode (old behaviour / rollback) ---------------------------------
# Browser calls the backend host directly; backend CORS_ALLOWED_ORIGINS must
# include this site's origin. To roll back: set the line below and rebuild.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
