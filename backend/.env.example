# Local development defaults - copy to .env and adjust as needed.
# Never commit a real .env file (rules.md Rule 17.3 - never expose secrets).

SPRING_PROFILES_ACTIVE=local

# Not needed for the "local" profile - application-local.yml already
# supplies its own throwaway JWT secret and ignores this variable.
# Required (application startup fails without it) for "test" and
# "production" profiles that don't hardcode a value.
JWT_SECRET=

# Only needed for the "test" and "production" profiles - local uses the
# hardcoded values in application-local.yml against docker-compose.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
REDIS_URL=

# Only needed for the "production" profile (Phase 2 OTP delivery via
# Brevo Transactional SMS). Not required for local/test - both use
# non-SMS OtpSender implementations instead.
BREVO_API_KEY=
BREVO_SMS_SENDER_NAME=FirstFood
